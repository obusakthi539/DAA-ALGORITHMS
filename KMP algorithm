static int Search(String text, String pattern) {
    //write your code here...
    int lps[]=build(pattern);
    int i=0,j=0;
    while(i<text.length()){
        if(text.charAt(i)==pattern.charAt(j)){
            i++;
            j++;
        }
        else {
            if(j!=0) j=lps[j-1];
            else i++;
        }
        if(j==pattern.length()) return i-j;
    }
    return -1;
}
static int[] build(String pattern) {
    int lps[]=new int[pattern.length()];
    int i=1,j=0;
    while(i<pattern.length()){
        if(pattern.charAt(i)==pattern.charAt(j)){
            j++;
            lps[i]=j;
            i++;
        }
        else {
            if(j!=0) j=lps[j-1];
            else i++;
        }
        
    }
    return lps;
}

 static int Search(String t,String p)
{
    	int n=t.length(); 
    	int m=p.length();
    	if(m>n)
    	{
    		return -1;
    	}
    	for(int i=0;i<=n-m;i++)
    	{
    		int j=0;
    		for(j=0;j<m;j++)
    		{
    			if(t.charAt(i+j)!=p.charAt(j))
    			{
    				break;
    			}
    		}
    		if(j==m)
    		{
    			return i;
    		}
    	}
    	return -1;
}







































































































import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner sc=new Scanner(System.in);
      int n=sc.nextInt();
      char arr[][]=new char[n][n];
      for(int i=0; i<n; i++) 
      Arrays.fill(arr[i],'.');
      queen(0,n,arr);
    }
    public static void queen(int row,int n,char arr[][]) {
      if(row==n) {
        for(int i=0; i<n; i++) {
          for(int j=0; j<n; j++) {
            System.out.print(arr[i][j]+" ");
          }
          System.out.println();
        }
        System.out.println();
      }
      
      for(int col=0; col<n; col++) {
        if(issafe(row,col,arr,n)){
          arr[row][col]='Q';
          queen(row+1,n,arr);
          arr[row][col]='.';
        }
      }
      
    }
    public static boolean issafe(int row,int col,char arr[][],int n) {
      for(int i=0; i<n; i++){
        if(arr[i][col]=='Q') return false;
      }
      
      for(int i=row,j=col; i>=0 && j>=0; i--,j--) {
        if(arr[i][j]=='Q') return false;
      }
      for(int i=row,j=col; i>=0 && j<n; i--,j++) {
        if(arr[i][j]=='Q') return false;
      }
      return true;
    }
}

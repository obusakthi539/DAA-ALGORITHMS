
//Brute Force
package Backtracking;
import java.util.*;
public class WellformedParen {
    static boolean isValid(String s) {
        int b = 0;
        for (char c : s.toCharArray()) {
            if (c == '(')
                b++;
            else
                b--;
            if (b < 0)
                return false;
        }
        return b == 0;
    }

    static void generate(int n, String cur, List<String> res) {
        if (cur.length() == 2 * n) {
            if (isValid(cur))
                res.add(cur);
            return;
        }
        generate(n, cur + "(", res);
        generate(n, cur + ")", res);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        List<String> res = new ArrayList<>();
        generate(n, "", res);
        Collections.sort(res);
        for (String s : res)
            System.out.println(s);
    }
}




package Plan;
import java.util.*;
public class Colectionss {
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		ArrayList<String> l=new ArrayList<>();
		for(int i=1;i<=n;i++)
		{if(i%3==0 &&i%5==0){
				l.add("FizzBuzz");
			}else if(i%5==0){
				l.add("Buzz");
			}else if(i%3==0){
				l.add("Fizz");
			}else{
				l.add(Integer.toString(i));
			}}
		for(int i=0;i<l.size();i++)
		{
			System.out.print(l.get(i)+" ");
		}
		
	}
}
